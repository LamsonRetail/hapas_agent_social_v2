# /opt/hindsight/.env  (chủ hindsight:hindsight, chmod 600) — KHÔNG commit bản thật.
# Tham chiếu: docs Hindsight 0.10.2 configuration.md.

# --- mạng: chỉ localhost (unit cũng ép lại) ---
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888
HINDSIGHT_API_MCP_ENABLED=false
HINDSIGHT_API_LOG_LEVEL=info
HINDSIGHT_API_WORKER_ID=hindsight-vps

# --- Postgres 16 hệ thống, Unix socket, xác thực peer (user hệ điều hành = role) ---
HINDSIGHT_API_DATABASE_URL=postgresql://hindsight@/hindsight?host=/var/run/postgresql
HINDSIGHT_API_TEXT_SEARCH_EXTENSION_NATIVE_LANGUAGE=simple

# --- KHÔNG LLM: lưu nguyên văn (chunks), không quan sát, không gộp ---
HINDSIGHT_API_LLM_PROVIDER=none
HINDSIGHT_API_RETAIN_EXTRACTION_MODE=chunks
HINDSIGHT_API_ENABLE_OBSERVATIONS=false
HINDSIGHT_API_ENABLE_AUTO_CONSOLIDATION=false

# --- embedding đa ngữ nhỏ (ONNX, không torch), reranker rrf (không cross-encoder) ---
HINDSIGHT_API_EMBEDDINGS_PROVIDER=onnx
HINDSIGHT_API_EMBEDDINGS_ONNX_MODEL_ID=intfloat/multilingual-e5-small
HINDSIGHT_API_EMBEDDINGS_ONNX_MODEL_PATH=/opt/hindsight/models/intfloat__multilingual-e5-small/onnx/model.onnx
HINDSIGHT_API_EMBEDDINGS_ONNX_TOKENIZER_NAME_OR_PATH=/opt/hindsight/models/intfloat__multilingual-e5-small
HINDSIGHT_API_EMBEDDINGS_ONNX_DIMENSIONS=384
HINDSIGHT_API_EMBEDDINGS_ONNX_QUERY_PREFIX="query: "
HINDSIGHT_API_EMBEDDINGS_ONNX_PASSAGE_PREFIX="passage: "
HINDSIGHT_API_RERANKER_PROVIDER=rrf
HF_HUB_OFFLINE=1

# --- xác thực: mọi request phải có Authorization: Bearer <khoá> ---
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
# Sinh: openssl rand -hex 32 ; dán CÙNG giá trị vào MARK_HINDSIGHT_API_KEY trong .env của Mark.
HINDSIGHT_API_TENANT_API_KEY=
