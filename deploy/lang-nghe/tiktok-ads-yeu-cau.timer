# /etc/systemd/system/tiktok-ads-yeu-cau.timer — mỗi 10 phút kiểm cờ "Đồng bộ ngay" (19/10/2026).
# Dashboard KHÔNG chạy đồng bộ trong tiến trình web: nút chỉ ghi ket_noi_ngoai.yeu_cau_dong_bo_luc;
# lượt này chạy `dong-bo --chi-khi-yeu-cau` (không có yêu cầu thì thoát < 1 giây, không in gì).
# Không chạy chồng với tiktok-ads-dong-bo (06:30) — khoá advisory Postgres.
[Unit]
Description=Dong bo TikTok Ads theo yeu cau (moi 10 phut)

[Timer]
OnBootSec=5min
OnUnitInactiveSec=10min
AccuracySec=30s
Unit=tiktok-ads-yeu-cau.service

[Install]
WantedBy=timers.target
