# /etc/systemd/system/meta-ads-dong-bo.service — một lượt đồng bộ Meta Ads vào kho lang_nghe
# (dashboard/meta_ads.py, 20/10/2026). Bộ hẹn giờ meta-ads-dong-bo.timer gọi mỗi ngày 06:45 giờ VN.
# Chạy bằng user của dashboard (lang_nghe_web: role Postgres trùng tên, peer auth) với cùng venv + .env
# (TIKTOK_KHOA_MA_HOA — khoá chung TikTok + Meta, META_API_VERSION tuỳ chọn, BQ_*). Chưa kết nối / token bị từ chối: ghi trạng thái rồi thoát 0 (không đỏ).
# Lần đầu mỗi tài khoản nạp lùi 90 ngày — có thể chạy vài chục phút; hai bộ hẹn giờ (06:45 và
# 2 phút theo yêu cầu) và lệnh tay không bao giờ chạy chồng (khoá advisory Postgres). README mục 7.
[Unit]
Description=Dong bo Meta Ads vao kho lang_nghe (dashboard social.hapas.vn)
After=network-online.target postgresql.service
Wants=network-online.target
# Soát 20/10/2026 H2 + N2: lượt hằng ngày CHỜ khoá (≤ 30 phút, --cho-khoa-phut) khi lượt nhỏ đang
# chạy; vẫn không có khoá → thoát 3 → systemd chạy lại SAU 10 phút — CHỈ với mã 3
# (RestartForceExitStatus, Restart=no: lỗi khác, bị giết vì quá TimeoutStartSec 6 giờ, SIGTERM
# không bao giờ chạy lại → không vòng lặp giữ khoá cả ngày; nạp lùi dở dang lượt hằng ngày SAU tự đọc
# tiếp nhờ mốc tk_quang_cao.nap_lui_tu ghi sau mỗi cửa sổ 30 ngày). Mỗi lần chờ ≤ 30 phút + 10 phút
# nghỉ: lần đầu + 3 lần chạy lại ≈ 2 giờ 40 phút, trong cửa sổ 6 giờ (Burst 4 = lần đầu + 3).
# Hỏng hẳn (hết lượt chạy lại, lỗi khác, quá giờ) → OnFailure ghi lỗi lên thẻ kết nối của dashboard
# (qc-dong-bo-loi@.service) — không nằm im. Cần systemd ≥ 244 (Restart cho Type=oneshot); VPS:
# systemd 255 (Ubuntu 24.04). Gỡ trạng thái failed sau khi xử lý: systemctl reset-failed meta-ads-dong-bo.
StartLimitIntervalSec=6h
StartLimitBurst=4
OnFailure=qc-dong-bo-loi@meta_ads.service

[Service]
Type=oneshot
User=lang_nghe_web
Group=lang_nghe_web
EnvironmentFile=/opt/lang-nghe/.env
Environment=HOME=/opt/lang-nghe
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/lang-nghe/app
ExecStart=/opt/lang-nghe/venv/bin/python -m dashboard.meta_ads dong-bo
# Nạp lùi 90 ngày của tài khoản lớn: nhiều nghìn lượt gọi tuần tự. Quá 6 giờ thì dừng (lượt sau
# đọc tiếp phần còn thiếu — mốc tk_quang_cao.nap_lui_tu ghi sau mỗi cửa sổ 30 ngày; upsert không nhân đôi).
TimeoutStartSec=6h
Restart=no
RestartForceExitStatus=3
RestartSec=10min
Nice=10
MemoryMax=512M
CPUQuota=50%
TasksMax=64
# hardening — như lang-nghe-dashboard.service
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/opt/mark
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# AF_UNIX: socket Postgres (peer). AF_INET/6: gọi RA graph.facebook.com (chỉ GET) + BigQuery.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
ProtectHostname=yes
ProtectClock=yes
SystemCallArchitectures=native
UMask=0077
