# /etc/systemd/system/tiktok-ads-dong-bo.service — một lượt đồng bộ TikTok Ads vào kho lang_nghe
# (dashboard/tiktok_ads.py, 19/10/2026). Bộ hẹn giờ tiktok-ads-dong-bo.timer gọi mỗi ngày 06:30 giờ VN.
# Chạy bằng user của dashboard (lang_nghe_web: role Postgres trùng tên, peer auth) với cùng venv + .env
# (TIKTOK_KHOA_MA_HOA, BQ_*). Chưa kết nối / token hết hạn: ghi trạng thái rồi thoát 0 (không đỏ).
# Lần đầu mỗi tài khoản nạp lùi 90 ngày — có thể chạy vài chục phút; hai bộ hẹn giờ (06:30 và
# 2 phút theo yêu cầu) và lệnh tay không bao giờ chạy chồng (khoá advisory Postgres). README mục 7.
[Unit]
Description=Dong bo TikTok Ads vao kho lang_nghe (dashboard social.hapas.vn)
After=network-online.target postgresql.service
Wants=network-online.target
# Soát 20/10/2026 H2: lượt hằng ngày CHỜ khoá (≤ 30 phút, --cho-khoa-phut) khi lượt nhỏ đang chạy;
# vẫn không có khoá → thoát 3 → Restart=on-failure chạy lại (tối đa 3 lần / 4 giờ), không lặng lẽ mất.
StartLimitIntervalSec=4h
StartLimitBurst=3

[Service]
Type=oneshot
User=lang_nghe_web
Group=lang_nghe_web
EnvironmentFile=/opt/lang-nghe/.env
Environment=HOME=/opt/lang-nghe
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/lang-nghe/app
ExecStart=/opt/lang-nghe/venv/bin/python -m dashboard.tiktok_ads dong-bo
# Nạp lùi 90 ngày của tài khoản lớn: nhiều nghìn lượt gọi tuần tự. Quá 6 giờ thì dừng (lượt sau
# đọc tiếp phần còn thiếu — mốc tk_quang_cao.nap_lui_tu ghi sau mỗi cửa sổ 30 ngày; upsert không nhân đôi).
TimeoutStartSec=6h
Restart=on-failure
RestartSec=10min
Nice=10
MemoryMax=512M
CPUQuota=50%
TasksMax=64
# hardening — như lang-nghe-dashboard.service
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/opt/mark
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# AF_UNIX: socket Postgres (peer). AF_INET/6: gọi RA business-api.tiktok.com + BigQuery.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
ProtectHostname=yes
ProtectClock=yes
SystemCallArchitectures=native
UMask=0077
