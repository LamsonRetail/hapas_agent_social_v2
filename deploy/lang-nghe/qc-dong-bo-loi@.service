# /etc/systemd/system/qc-dong-bo-loi@.service — ghi lỗi lượt đồng bộ quảng cáo HẰNG NGÀY lên thẻ kết nối
# của dashboard (soát 20/10/2026 N2). %i = tiktok_ads | meta_ads. Được gọi bởi OnFailure= của
# tiktok-ads-dong-bo.service / meta-ads-dong-bo.service khi lượt hằng ngày hỏng hẳn (hết 3 lần chạy lại vì
# khoá bận, lỗi khác, quá 6 giờ): trạng thái kết nối = "loi" + lý do → quản trị viên thấy "có lỗi" trên
# trang Quảng cáo / dải "Số quảng cáo" (lượt thành công sau đó tự đặt lại "hoạt động"). Không token,
# không gọi mạng ngoài. Cùng user, venv, .env và hardening với *-ads-dong-bo.
[Unit]
Description=Bao loi luot dong bo quang cao hang ngay (%i)
After=postgresql.service

[Service]
Type=oneshot
User=lang_nghe_web
Group=lang_nghe_web
EnvironmentFile=/opt/lang-nghe/.env
Environment=HOME=/opt/lang-nghe
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/lang-nghe/app
ExecStart=/opt/lang-nghe/venv/bin/python -m dashboard.nghe_qc %i --bao-loi-dong-bo
TimeoutStartSec=2min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/opt/mark
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
ProtectHostname=yes
ProtectClock=yes
SystemCallArchitectures=native
UMask=0077
