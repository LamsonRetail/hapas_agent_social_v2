# /etc/phoenix/phoenix.env  (chmod 0600, chủ root) — đọc bởi phoenix.service.
# Không có comment cuối dòng: systemd EnvironmentFile coi cả phần sau dấu = là giá trị.

# --- bind / lưu trữ ---
PHOENIX_HOST=127.0.0.1
PHOENIX_PORT=6006
# gRPC vẫn bind [::] bất kể PHOENIX_HOST — ufw (default deny incoming) chặn từ ngoài.
PHOENIX_GRPC_PORT=4317
PHOENIX_WORKING_DIR=/var/lib/phoenix
PHOENIX_SQL_DATABASE_URL=sqlite:////var/lib/phoenix/phoenix.db

# --- giữ dữ liệu / bộ nhớ ---
# 0 = giữ mãi (mặc định của Phoenix)
PHOENIX_DEFAULT_RETENTION_POLICY_DAYS=30
# mặc định 20000; nhỏ hơn để RAM không phình khi Phoenix ghi chậm
PHOENIX_MAX_SPANS_QUEUE_SIZE=5000

# --- không gọi ra ngoài ---
PHOENIX_TELEMETRY_ENABLED=false
PHOENIX_ALLOW_EXTERNAL_RESOURCES=false

# --- tắt bề mặt không dùng ---
PHOENIX_ENABLE_MCP_SERVER=false
PHOENIX_ENABLE_MCP_CODE_MODE=false
PHOENIX_ENABLE_OAUTH2_AUTHORIZATION_SERVER=false
PHOENIX_ENABLE_PROMETHEUS=false

# --- đăng nhập ---
PHOENIX_ENABLE_AUTH=true
# openssl rand -hex 32  (ký JWT; KHÔNG commit giá trị thật)
PHOENIX_SECRET=__THAY_BANG_openssl_rand_hex_32__
# Chỉ đọc ở lần khởi động đầu; đăng nhập admin@localhost rồi đổi ngay.
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=__THAY_BANG_MAT_KHAU_MANH__
PHOENIX_ENABLE_STRONG_PASSWORD_POLICY=true
# http thường qua SSH tunnel
PHOENIX_USE_SECURE_COOKIES=false
