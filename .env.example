# Lark app: bot identity only (tenant_access_token)
LARK_APP_ID=cli_xxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LARK_BASE_URL=https://open.larksuite.com

# Isolated lark-cli config for this bot app
LARKSUITE_CLI_CONFIG_DIR=.lark-cli-bot
# LARK_CLI_PATH=C:\Users\PC\AppData\Local\hermes\node\lark-cli.cmd

# Hermes brain; this hermes-home is shared with the meeting agent
HERMES_HOME=C:\Users\PC\AppData\Local\hermes
HERMES_AGENT_DIR=C:\Users\PC\AppData\Local\hermes\hermes-agent
AGENT_MODEL=gpt-5.6-terra
AGENT_PROVIDER=openai-codex
AGENT_MAX_ITERATIONS=14
AGENT_MAX_WORKERS=2
AGENT_REPLY_TIMEOUT=180

# Social listening: TikTok/Facebook/Instagram/Threads via Apify
APIFY_TOKEN=apify_api_xxxxxxxxxxxx
APIFY_MAX_CHARGE_USD=1.0

# YouTube uses the official YouTube Data API v3 (no paid Apify fallback)
# Enable the API in Google Cloud, then create/restrict an API key for it
YOUTUBE_DATA_API_KEY=AIza_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional event/runtime overrides
LARK_EVENT_KEY=im.message.receive_v1
LARK_EVENT_RESPAWN_SECONDS=5400
AGENT_TYPING_BADGE=1


# IMPORTANT: put comments on their own lines. This loader does not strip an
# end-of-line comment, so never write: AGENT_MAX_WORKERS=2  # comment

# ---- Audit toan luong (tuy chon) ----
# AUDIT_ENABLED=0     # tat han audit
# AUDIT_TO_BASE=0     # chi ghi JSONL, khong day len Lark Base

# ---- LSR Agent Platform (bắt buộc dùng TEST trước) ----
# LSR_COLLECTOR=https://collector.34-124-212-76.sslip.io
# LSR_AGENT_ID=AG-SOCIAL-LISTENING-TEST
# LSR_TELEMETRY_API_KEY=lsr_tel_xxx
# LSR_CONTEXT_ENV=dev
# LSR_JOB_POLL_ENABLED=1
# Production poll bị chặn trừ khi chủ động đặt LSR_ALLOW_PRODUCTION_POLL=1.
# LSR_ALLOW_PRODUCTION_POLL=0
# Policy planner: off | observe | enforce
LSR_POLICY_MODE=enforce
