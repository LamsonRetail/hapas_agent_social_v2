# ── Lark app (dùng CHÍNH cái bot app bạn đã có; ta chỉ mint token + chạy OAuth) ──
LARK_APP_ID=cli_xxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Endpoints (Lark Suite quốc tế). Feishu (TQ) đổi sang open.feishu.cn / accounts.feishu.cn ──
LARK_BASE_URL=https://open.larksuite.com
LARK_AUTH_BASE_URL=https://accounts.larksuite.com

# Redirect URI PHẢI trùng với cấu hình trong Lark Developer Console (Security settings).
LARK_REDIRECT_URI=http://localhost:3001/oauth/callback
OAUTH_PORT=3001

# ── Scope OAuth (as user). Để trống hoặc "all" => xin toàn bộ scope app đang có.
#    Nếu tự liệt kê: Lark HARD-FAIL (lỗi 20043) nếu có scope app CHƯA được cấp.
# LARK_SCOPE=all

# ── Lưu token của user seat Steven ──
LARK_TOKEN_FILE=.tokens/steven.json
LARK_POLL_CHATS_FILE=.tokens/poll-chats.json

# ── Polling ──
LARK_POLL_SECONDS=3

# ── Hermes brain (openai-codex, quota "as user"). Mặc định trỏ sang hermes-home cạnh folder này ──
# HERMES_HOME=D:\Project\Hermes Agent\hermes-home
# HERMES_AGENT_DIR=D:\Project\Hermes Agent\hermes-home\hermes-agent
AGENT_MODEL=gpt-5.4
AGENT_PROVIDER=openai-codex
AGENT_MAX_ITERATIONS=6
