# /opt/lang-nghe/.env — biến môi trường của dashboard (EnvironmentFile của systemd).
# Quyền tệp: 600, chủ root (systemd đọc trước khi hạ quyền). KHÔNG commit, KHÔNG dán vào chat.

# Ứng dụng Lark RIÊNG cho dashboard (Lark Developer, bản quốc tế) — không dùng app của bot Mark.
DASH_LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
DASH_LARK_APP_SECRET=__THAY__
# Địa chỉ công khai; redirect URL cần khai trên Lark = DASH_BASE_URL + /dang-nhap/xong
DASH_BASE_URL=https://social.hapas.vn
# Khoá ký phiên đăng nhập/CSRF: ≥ 32 ký tự hex, tạo RIÊNG (openssl rand -hex 32), KHÁC
# LANG_NGHE_BAO_KHOA — dashboard không khởi động nếu hai khoá trùng. Đổi khoá = mọi người đăng nhập lại.
DASH_SESSION_KEY=__KHOA_PHIEN_openssl_rand_hex_32__
# tenant_key của tổ chức Lark HAPAS: tài khoản Lark của tổ chức khác bị chặn dù email trùng.
DASH_LARK_TENANT_KEY=__TENANT_KEY_HAPAS__
# Tuỳ chọn: scope xin khi uỷ quyền (mặc định chỉ đọc email). Thêm contact:user.employee:readonly
# để dùng email doanh nghiệp (enterprise_email, ưu tiên hơn email tự khai) — bật trong app Lark trước.
# DASH_LARK_SCOPE=contact:user.email:readonly
# Tuỳ chọn: đổi máy chủ Lark (mặc định open.larksuite.com / accounts.larksuite.com)
# LARK_OPEN_BASE=https://open.larksuite.com/open-apis
# LARK_ACCOUNTS_BASE=https://accounts.larksuite.com/open-apis

# Kho Postgres: mặc định Unix socket + peer, role lang_nghe_web = user hệ điều hành
# LANG_NGHE_WEB_DSN=dbname=lang_nghe

# Khoá Mark gửi kèm khi báo "có dữ liệu mới" — PHẢI trùng LANG_NGHE_BAO_KHOA trong .env của Mark,
# và KHÁC DASH_SESSION_KEY (≥ 32 ký tự hex, tạo bằng một lần openssl rand -hex 32 RIÊNG).
# Để trống = từ chối mọi lời báo (dashboard vẫn tự kiểm 30 giây một lần).
LANG_NGHE_BAO_KHOA=__KHOA_BAO_openssl_rand_hex_32__

# Đồng bộ BigQuery (dashboard/dong_bo_bq.py). Để trống BQ_DATASET = tắt đồng bộ.
BQ_DATASET=ganesha-381907.SOCIAL_LISTENING
BQ_LOCATION=asia-southeast1
GOOGLE_APPLICATION_CREDENTIALS=/opt/lang-nghe/bq-sa.json
